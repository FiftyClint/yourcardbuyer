{
  "name": "yourcardbuyer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:launch": "node scripts/check.mjs --launch",
    "test": "node --test worker/*.test.mjs",
    "verify": "npm run build && npm run check && npm test",
    "dev": "npm run build -- --site && wrangler dev",
    "deploy": "npm run build -- --site && npm run check:launch && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
